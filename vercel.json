{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|facebook|twitter|discord|slack|whatsapp|telegram|pinterest|linkedin|vkshare|yandex|applebot|bingbot|baiduspider|skype|viber|snapchat|reddit|tumblr).*"
        }
      ],
      "destination": "/api/index.js?seo_bot=true&path=/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
